# AxoMEME environment variables
#
# Copy this file to .env and fill in as needed.
# .env is gitignored and should never be committed.

# Hugging Face token — currently required while the model repo is gated.
# Once the repo is made public, this will no longer be needed.
# Get a token at: https://huggingface.co/settings/tokens (read access is sufficient)
HF_TOKEN=

# Override the default model variant (default: general)
# AXOMEME_VARIANT=viral

# Override weights path (bypasses HF download entirely)
# Supports both .pt and .safetensors formats
# AXOMEME_WEIGHTS=/path/to/model.pt

# Override cache directory for downloaded weights (default: ~/.cache/axomeme)
# AXOMEME_CACHE=/custom/cache/dir
