# HyphAeon environment variables
#
# Copy this file to .env and fill in as needed.
# .env is gitignored and should never be committed.

# Hugging Face token — not required for public model weights.
# Only needed if accessing private/gated HF repos.
# HF_TOKEN=

# Override the default model variant (default: general)
# HYPHAEON_VARIANT=viral

# Override weights path (bypasses HF download entirely)
# Supports both .pt and .safetensors formats.
# .safetensors files saved via aeon_core.weights.save_safetensors() are
# self-describing (arch params live in the header __metadata__ block);
# otherwise load_arch_config falls back to a sibling *.config.json,
# then to built-in defaults with a warning.
# HYPHAEON_WEIGHTS=/path/to/model.safetensors

# chronaeon equivalents (fall back to HYPHAEON_* if unset)
# CHRONAEON_VARIANT=viral
# CHRONAEON_WEIGHTS=/path/to/model.safetensors

# Weights download to the standard Hugging Face hub cache
# (~/.cache/huggingface/hub). Use HF's own env vars to relocate it:
# HF_HUB_CACHE=/custom/hub/cache  (or HF_HOME for the whole HF dir)
